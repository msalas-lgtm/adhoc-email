<script>
window.addEventListener('load', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const rep = urlParams.get('sales_rep');
    
    if (rep) {
        // Find all links/buttons on the page
        document.querySelectorAll('a').forEach(link => {
            const url = new URL(link.href);
            // Only add to your own internal links
            if (url.hostname === window.location.hostname) {
                url.searchParams.set('sales_rep', rep);
                link.href = url.toString();
            }
        });
    }
});
</script>


<script>
	/**
	 * Updates only images missing Alt or Title tags
	 * @param {string} siteName - The name of your website
	 * @param {string} pageName - The specific page or category
	 */
	function fixMissingImageMetadata(siteName, pageName) {
		const images = document.querySelectorAll('img');

		images.forEach((img, index) => {
			const seoString = `${siteName} - ${pageName} image ${index + 1}`;

			// Check if alt is missing, empty, or just whitespace
			if (!img.getAttribute('alt') || img.alt.trim() === "") {
				img.alt = seoString;
			}

			// Check if title is missing, empty, or just whitespace
			if (!img.getAttribute('title') || img.title.trim() === "") {
				img.title = seoString;
			}
		});
	}

	// Execution
	fixMissingImageMetadata("PixelCraft Studio", "Portfolio");
</script>

