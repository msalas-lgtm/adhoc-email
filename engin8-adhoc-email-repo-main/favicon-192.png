<script>
(function() {
    // 1. Try to get the name from the URL
    const urlParams = new URLSearchParams(window.location.search);
    let repName = urlParams.get('sales_rep');

    // 2. If it's in the URL, save it to the browser's "Session Storage"
    if (repName) {
        sessionStorage.setItem('saved_sales_rep', repName);
    } 
    // 3. If it's NOT in the URL, try to get it from the browser's memory
    else {
        repName = sessionStorage.getItem('saved_sales_rep');
    }

    // 4. If we found a name (either in URL or memory), put it in the iframe
    if (repName) {
        // Wait a split second for the iframe to exist
        const checkIframe = setInterval(function() {
            const zohoIframe = document.querySelector('iframe[src*="forms.zohopublic.com"]');
            
            if (zohoIframe) {
                const currentSrc = new URL(zohoIframe.src);
                // Set the field SingleLine1 to the repName
                currentSrc.searchParams.set('SingleLine1', repName);
                
                zohoIframe.src = currentSrc.toString();
                
                clearInterval(checkIframe); // Stop looking once we fix the iframe
            }
        }, 100); // Check every 100ms
        
        // Safety: Stop checking after 5 seconds so it doesn't run forever
        setTimeout(() => clearInterval(checkIframe), 5000);
    }
})();
</script>

